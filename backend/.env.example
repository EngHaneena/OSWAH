# ===== مفاتيح الخلفية فقط (لا تُوضع في Next.js أو المتصفح) =====
OPENAI_API_KEY=sk-put-your-key-here
# تأكدوا من أسماء النماذج المتاحة في حسابكم
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# ===== مصدر «موقف مماثل من السيرة» =====
# dorar = يبحث في الدرر السنية مباشرة (الافتراضي) | excel = قاعدة أُسوة بالمتجهات
SITUATION_SOURCE=dorar

# ===== البيانات والفهرس (لوضع excel) =====
EXCEL_PATH=data/asowa_complete_integration_.xlsx
CHROMA_DIR=chroma_store
# documented = المواقف المكتملة التوثيق | approved = المعتمد شرعياً فقط
CONTENT_GATE=documented
# اضبطوه بعد التجربة:  python main.py --probe "نص"
SIMILARITY_THRESHOLD=0.30
TOP_K=3

# ===== الدرر السنية (الواجهة الرسمية: dorar.net/article/389، بلا مفتاح؛ راسلوهم لتأكيد الإذن) =====
DORAR_API_URL=https://dorar.net/dorar_api.json
DORAR_TIMEOUT=12

# ===== الأمان =====
ALLOWED_ORIGINS=http://localhost:3000
# سر مشترك (أحرف إنجليزية فقط): نفس القيمة في frontend/.env.local، فلا يقبل السيرفر إلا طلبات Next.js
BACKEND_SHARED_SECRET=change-me-oswah-2026
# أرقام الطوارئ (تُراجع قبل الإطلاق)
EMERGENCY_NUMBERS=[{"label":"الطوارئ الموحد","number":"911"},{"label":"وزارة الصحة","number":"937"}]
